{
  "fields": [
    {
      "field_id": "source_mode",
      "type": "dropdown",
      "label_name": "Source Type",
      "default_input": "folder",
      "pre_defined_dropdown": [
        [
          "folder",
          "Folder (Bulk)"
        ]
      ],
      "field_visibility": false
    },
    {
      "field_id": "source_folder",
      "type": "file",
      "label_name": "Source Folder",
      "mode": "folder",
      "placeholder": "Folder containing your image frames",
      "required": true
    },
    {
      "field_id": "output_folder",
      "type": "file",
      "label_name": "Output Folder",
      "mode": "folder",
      "placeholder": "Folder where the converted video will be saved",
      "required": true
    },
    {
      "field_id": "output_type",
      "type": "dropdown",
      "label_name": "Output Type",
      "default_input": "mp4_h264",
      "pre_defined_dropdown": [
        [
          "mp4_h264",
          "MP4 h264"
        ],
        [
          "mp4_av1",
          "MP4 AV1"
        ],
        [
          "webm",
          "WebM"
        ],
        [
          "gif",
          "GIF"
        ],
        [
          "apng",
          "APNG"
        ],
        [
          "webp",
          "WEBP"
        ]
      ]
    },
    {
      "field_id": "fps",
      "type": "number",
      "label_name": "Frames Per Second (FPS)",
      "default_input": 30,
      "min": 1,
      "allow_decimal": true,
      "step": 0.001,
      "tooltip": "Manual value, or pick a preset (integer / broadcast & decimal)."
    },
    {
      "field_id": "quality_mode",
      "type": "dropdown",
      "label_name": "Quality Mode",
      "default_input": "CRF",
      "pre_defined_dropdown": [
        [
          "CRF",
          "Constant Quality (CRF)"
        ],
        [
          "Bitrate",
          "Bitrate (CBR)"
        ],
        [
          "2-Pass VBR",
          "2-Pass VBR"
        ],
        [
          "Lossless",
          "Lossless"
        ]
      ],
      "show_if": {
        "field": "output_type",
        "in": [
          "mp4_h264",
          "mp4_av1",
          "webm",
          "webp"
        ]
      }
    },
    {
      "field_id": "crf",
      "type": "number",
      "label_name": "CRF Quality (Lower = Better)",
      "default_input": 18,
      "min": 0,
      "max": 63,
      "allow_decimal": false,
      "tooltip": "GIF / APNG do not use a CRF value.",
      "show_if": {
        "all": [
          {
            "field": "output_type",
            "in": [
              "mp4_h264",
              "mp4_av1",
              "webm",
              "webp"
            ]
          },
          {
            "field": "quality_mode",
            "equals": "CRF"
          }
        ]
      }
    },
    {
      "field_id": "bitrate",
      "type": "number",
      "label_name": "Bitrate (kbps)",
      "default_input": 8000,
      "min": 1,
      "allow_decimal": false,
      "tooltip": "Used by Bitrate and 2-Pass VBR modes.",
      "show_if": {
        "field": "quality_mode",
        "in": [
          "Bitrate",
          "2-Pass VBR"
        ]
      }
    },
