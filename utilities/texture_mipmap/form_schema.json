{
  "fields": [
    {
      "field_id": "source_mode",
      "type": "dropdown",
      "label_name": "Source Type",
      "default_input": "single",
      "pre_defined_dropdown": [
        [
          "single",
          "Single Texture"
        ],
        [
          "bulk",
          "Folder (bulk)"
        ]
      ]
    },
    {
      "field_id": "source",
      "type": "file",
      "label_name": "Source",
      "mode": {
        "parts": [
          [
            "source_mode",
            "bulk",
            "folder"
          ]
        ],
        "default": "file"
      },
      "file_types": "Images (*.png;*.jpg;*.jpeg;*.webp;*.tga;*.tiff;*.bmp)",
      "required": true,
      "placeholder": "The texture image file"
    },
    {
      "field_id": "output",
      "type": "file",
      "label_name": "Output Folder",
      "mode": "folder",
      "placeholder": "Where the mip levels will be saved",
      "required": true
    },
    {
      "field_id": "normal_map",
      "type": "checkbox",
      "label_name": "Normal Map",
      "default_input": false,
      "tooltip": "Enables normal-map compatible resampling that avoids flipping signed channels."
    },
    {
      "field_id": "npot_mode",
      "type": "dropdown",
      "label_name": "Non-Power-Of-Two Handling",
      "default_input": "none",
      "pre_defined_dropdown": [
        [
          "none",
          "None (keep as-is)"
        ],
        [
          "pad_edge",
          "Pad to Next Power Of Two (edge)"
        ],
        [
          "stretch",
          "Stretch to Nearest Power Of Two"
        ]
      ]
    },
    {
      "field_id": "resample_filter",
      "type": "dropdown",
      "label_name": "Resample Filter",
      "default_input": "lanczos",
      "pre_defined_dropdown": [
        [
          "lanczos",
          "Lanczos"
        ],
        [
          "box",
          "Box"
        ],
        [
          "mitchell",
          "Mitchell / Cubic"
        ],
        [
          "bilinear",
          "Bilinear"
        ]
      ]
    },
    {
      "field_id": "export_dds",
      "type": "checkbox",
      "label_name": "Export DDS Container",
      "default_input": false,
      "tooltip": "Attempts a .dds container alongside the image files when imageio is available."
    },
    {
      "field_id": "image_format",
      "type": "dropdown",
      "label_name": "Image Format",
      "default_input": "png",
      "pre_defined_dropdown": [
        [
          "png",
          "PNG"
        ],
        [
          "jpg",
          "JPG"
        ],
        [
          "jpeg",
          "JPEG"
        ],
        [
          "webp",
          "WEBP"
        ],
        [
          "tga",
          "TGA"
        ],
        [
          "tiff",
          "TIFF"
        ]
      ]
    },
    {
      "field_id": "quality",
      "type": "number",
      "label_name": "Quality (1-100)",
      "default_input": 95,
      "min": 1,
      "max": 100,
      "allow_decimal": false,
      "show_if": {
        "any": [
          {
            "field": "image_format",
            "in": [
              "jpg",
              "jpeg",
              "webp"
            ]
          },
          {
            "all": [
              {
                "field": "image_format",
                "equals": "tiff"
              },
              {
                "field": "tiff_compression",
                "equals": "jpeg"
              }
            ]
          }
        ]
      }
    },
    {
      "field_id": "png_compress_level",
      "type": "number",
      "label_name": "PNG Compression Level (0-9)",
      "default_input": 6,
      "min": 0,
      "max": 9,
      "allow_decimal": false,
      "show_if": {
        "field": "image_format",
        "equals": "png"
      }
    },
    {
      "field_id": "tga_compression",
      "type": "dropdown",
      "label_name": "TGA Compression",
      "default_input": "none",
      "pre_defined_dropdown": [
        [
          "none",
          "None"
        ],
        [
          "rle",
          "RLE"
        ]
      ],
      "show_if": {
        "field": "image_format",
        "equals": "tga"
      }
    },
    {
      "field_id": "tiff_compression",
      "type": "dropdown",
      "label_name": "TIFF Compression",
      "default_input": "none",
      "pre_defined_dropdown": [
        [
          "none",
          "None"
        ],
        [
          "lzw",
          "LZW"
        ],
        [
          "zip",
          "ZIP"
        ],
        [
          "jpeg",
          "JPEG"
        ]
      ],
      "show_if": {
        "field": "image_format",
        "equals": "tiff"
      }
    },
    {
      "field_id": "retain_alpha",
      "type": "checkbox",
      "label_name": "Retain Alpha Channel",
      "default_input": true
    },
    {
      "field_id": "naming_template",
      "type": "text",
      "label_name": "Naming Template",
      "default_input": "{texture_name}_mip{level}.{ext}",
      "tooltip": "Tokens: {texture_name} {level} {ext}"
    }
  ]
}