{
  "fields": [
    {
      "field_id": "input_image",
      "label_name": "Source Image",
      "variable_name": "source",
      "optional": false,
      "required": true,
      "tooltip": "The image to watermark. Supports PNG, JPG, WEBP, TGA and BMP.",
      "placeholder": "Select an image...",
      "default_input": "",
      "classes": "wide",
      "type": "file",
      "mode": "input",
      "file_types": "Images (*.png;*.jpg;*.jpeg;*.webp;*.tga;*.bmp)",
      "enable_validation": true,
      "regex_validation": "\\.(png|jpe?g|webp|tga|bmp)$",
      "real_time_validation": false,
      "field_status": "idle",
      "field_visibility": true
    },
    {
      "field_id": "output_image",
      "label_name": "Output Image",
      "variable_name": "output",
      "optional": false,
      "required": true,
      "tooltip": "Where the watermarked image will be written.",
      "placeholder": "Select a destination...",
      "default_input": "",
      "classes": "wide",
      "type": "file",
      "mode": "output",
      "file_types": "Images (*.png;*.jpg;*.jpeg;*.webp)",
      "enable_validation": true,
      "regex_validation": "\\.(png|jpe?g|webp)$",
      "real_time_validation": false,
      "field_status": "idle",
      "field_visibility": true
    },
    {
      "field_id": "watermark_text",
      "label_name": "Watermark Text",
      "variable_name": "watermark_text",
      "optional": true,
      "required": false,
      "tooltip": "Text stamped over the image.",
      "placeholder": "e.g. © Lycan 2026",
      "default_input": "© Lycan 2026",
      "classes": "",
      "type": "text",
      "enable_validation": true,
      "real_time_validation": true,
      "regex_sanitization": {
        "pattern": "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f]",
        "replacement": ""
      },
      "field_status": "idle",
      "field_visibility": true,
      "min_length": 0,
      "max_length": 64
    },
    {
      "field_id": "watermark_alpha",
      "label_name": "Opacity %",
      "variable_name": "watermark_alpha",
      "optional": false,
      "required": false,
      "tooltip": "Watermark opacity from 0 (invisible) to 100 (solid).",
      "default_input": 40,
      "classes": "mini",
      "type": "number",
      "enable_validation": true,
      "real_time_validation": true,
      "field_status": "idle",
      "field_visibility": true,
      "min": 0,
      "max": 100,
      "force_clamp": true,
      "step": 1,
      "allow_decimal": false,
      "allow_negative": false
    },
    {
      "field_id": "watermark_color",
      "label_name": "Watermark Color",
      "variable_name": "watermark_color",
      "optional": false,
      "required": false,
      "tooltip": "RGB color of the text overlay.",
      "default_input": [255, 255, 255],
      "classes": "",
      "type": "color",
      "enable_validation": false,
      "field_status": "idle",
      "field_visibility": true
    },
    {
      "field_id": "font_size",
      "label_name": "Font Size",
      "variable_name": "font_size",
      "optional": false,
      "required": false,
      "tooltip": "Text scale relative to the image width.",
      "placeholder": "Auto",
      "default_input": 0,
      "classes": "mini",
      "type": "number",
      "enable_validation": true,
      "real_time_validation": true,
      "field_status": "idle",
      "field_visibility": true,
      "min": 8,
      "max": 512,
      "force_clamp": true,
      "step": 1,
      "allow_decimal": false,
      "allow_negative": false
    },
    {
      "field_id": "watermark_position",
      "label_name": "Position",
      "variable_name": "watermark_position",
      "optional": false,
      "required": false,
      "tooltip": "Where on the image the watermark is placed.",
      "default_input": "bottom_right",
      "classes": "",
      "type": "dropdown",
      "enable_validation": false,
      "field_status": "idle",
      "field_visibility": true,
      "pre_defined_dropdown": [
        ["top_left", "Top Left"],
        ["top_center", "Top Center"],
        ["top_right", "Top Right"],
        ["middle_left", "Middle Left"],
        ["center", "Center"],
        ["middle_right", "Middle Right"],
        ["bottom_left", "Bottom Left"],
        ["bottom_center", "Bottom Center"],
        ["bottom_right", "Bottom Right"]
      ]
    },
    {
      "field_id": "date_stamp",
      "label_name": "Add Date Stamp",
      "variable_name": "include_date",
      "optional": false,
      "required": false,
      "tooltip": "Append the current date to the watermark text.",
      "default_input": true,
      "classes": "",
      "type": "checkbox",
      "enable_validation": false,
      "field_status": "idle",
      "field_visibility": true
    }
  ]
}